<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <Authors>Vippy</Authors>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <RootNamespace>Jukebox</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <UserHome Condition="'$(UserHome)' == '' and '$(HOME)' != ''">$(HOME)</UserHome>
    <UserHome Condition="'$(UserHome)' == '' and '$(USERPROFILE)' != ''">$(USERPROFILE)</UserHome>
    <GalePluginsDir Condition="'$(GalePluginsDir)' == ''">$(UserHome)/.local/share/com.kesomannen.gale/repo/profiles/Developer/BepInEx/plugins</GalePluginsDir>
    <OutputPath>$(GalePluginsDir)/Jukebox/</OutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <RepoManagedDir Condition="'$(RepoManagedDir)' == '' and '$(REPO_MANAGED_DIR)' != ''">$(REPO_MANAGED_DIR)</RepoManagedDir>
    <RepoManagedDir Condition="'$(RepoManagedDir)' == '' and Exists('$(UserHome)/.local/share/Steam/steamapps/common/REPO/REPO_Data/Managed')">$(UserHome)/.local/share/Steam/steamapps/common/REPO/REPO_Data/Managed</RepoManagedDir>
    <RepoManagedDir Condition="'$(RepoManagedDir)' == '' and Exists('C:/Program Files (x86)/Steam/steamapps/common/REPO/REPO_Data/Managed')">C:/Program Files (x86)/Steam/steamapps/common/REPO/REPO_Data/Managed</RepoManagedDir>
    <RepoManagedDir Condition="'$(RepoManagedDir)' == '' and Exists('D:/Games/SteamLibrary/steamapps/common/REPO/REPO_Data/Managed')">D:/Games/SteamLibrary/steamapps/common/REPO/REPO_Data/Managed</RepoManagedDir>
  </PropertyGroup>

  <!-- Wardrobe.dll, which Jukebox hard-depends on. Override with -p:WardrobeDll=... or WARDROBE_DLL;
       otherwise the staged build in the Wardrobe repo next to this one, then the Developer profile. -->
  <PropertyGroup>
    <WardrobeDll Condition="'$(WardrobeDll)' == '' and '$(WARDROBE_DLL)' != ''">$(WARDROBE_DLL)</WardrobeDll>
    <WardrobeDll Condition="'$(WardrobeDll)' == '' and Exists('$(MSBuildProjectDirectory)/../../Wardrobe/BuildZip/Wardrobe/Wardrobe.dll')">$(MSBuildProjectDirectory)/../../Wardrobe/BuildZip/Wardrobe/Wardrobe.dll</WardrobeDll>
    <WardrobeDll Condition="'$(WardrobeDll)' == ''">$(UserHome)/.local/share/com.kesomannen.gale/repo/profiles/Developer/BepInEx/plugins/Wardrobe/Wardrobe.dll</WardrobeDll>
  </PropertyGroup>

  <PropertyGroup>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.1" PrivateAssets="all" IncludeAssets="build" />
    <PackageReference Include="BepInEx.Core" Version="5.*" ExcludeAssets="runtime" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.62" IncludeAssets="compile" PrivateAssets="all" />
    <Publicize Include="Assembly-CSharp" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(RepoManagedDir)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(RepoManagedDir)/Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PhotonUnityNetworking"><HintPath>$(RepoManagedDir)/PhotonUnityNetworking.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Photon3Unity3D"><HintPath>$(RepoManagedDir)/Photon3Unity3D.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PhotonRealtime"><HintPath>$(RepoManagedDir)/PhotonRealtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PhotonVoice"><HintPath>$(RepoManagedDir)/PhotonVoice.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PhotonVoice.API"><HintPath>$(RepoManagedDir)/PhotonVoice.API.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Wardrobe"><HintPath>$(WardrobeDll)</HintPath><Private>false</Private></Reference>
    <Reference Include="PhotonVoice.PUN"><HintPath>$(RepoManagedDir)/PhotonVoice.PUN.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <BuildInfoContent>// &lt;auto-generated/&gt;
namespace Jukebox
{
    internal static class BuildInfo
    {
        public const string Version = "$(Version)"%3B
    }
}
</BuildInfoContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(MSBuildProjectDirectory)/BuildInfo.g.cs" Lines="$(BuildInfoContent)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <!-- The source glob ran before this file existed on a fresh clone, so it is handed over here. -->
    <ItemGroup>
      <Compile Remove="BuildInfo.g.cs" />
      <Compile Include="BuildInfo.g.cs" />
    </ItemGroup>
  </Target>

  <UsingTask TaskName="UpdateManifestVersion" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ManifestPath ParameterType="System.String" Required="true" />
      <NewVersion ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var enc = new UTF8Encoding(false);
        var content = File.ReadAllText(ManifestPath, enc);
        var updated = Regex.Replace(content, "\"version_number\"\\s*:\\s*\"[^\"]*\"", "\"version_number\": \"" + NewVersion + "\"");
        if (updated != content) File.WriteAllText(ManifestPath, updated, enc);
      ]]></Code>
    </Task>
  </UsingTask>

  <ItemGroup>
    <InternalsVisibleTo Include="Jukebox.Tests" />
  </ItemGroup>

  <Target Name="PackageMod" AfterTargets="Build" Condition="'$(SkipPackageMod)' != 'true'">
    <PropertyGroup>
      <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/..'))</RepoRoot>
      <BuildZipParent>$(RepoRoot)/BuildZip</BuildZipParent>
      <StageDir>$(BuildZipParent)/Jukebox</StageDir>
      <OutputZip>$(BuildZipParent)/Jukebox-$(Version).zip</OutputZip>
      <SourceManifest>$(RepoRoot)/manifest.json</SourceManifest>
    </PropertyGroup>
    <UpdateManifestVersion ManifestPath="$(SourceManifest)" NewVersion="$(Version)" />
    <RemoveDir Directories="$(StageDir)" />
    <MakeDir Directories="$(StageDir)" />
    <Copy SourceFiles="$(OutputPath)Jukebox.dll" DestinationFolder="$(StageDir)" />
    <Copy SourceFiles="$(RepoRoot)/README.md;$(RepoRoot)/CHANGELOG.md;$(SourceManifest)" DestinationFolder="$(StageDir)" />
    <Delete Files="$(OutputZip)" />
    <ZipDirectory SourceDirectory="$(StageDir)" DestinationFile="$(OutputZip)" Overwrite="true" />
    <Message Importance="high" Text="[PackageMod] DLL -&gt; $(OutputPath)" />
    <Message Importance="high" Text="[PackageMod] zip -&gt; $(OutputZip) (v$(Version))" />
  </Target>

</Project>
